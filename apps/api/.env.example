APP_NAME=agent-app
NODE_ENV=development
HUNYUAN_API_KEY=
# E.14 学习期默认：qwen3.5-flash（对齐较弱，对 prompt-injection-notes.txt 会中招，便于对照防护前后）。
# 对比抗注入：可改回 minimax-m2.5（同 fixture 常答 Kyoto，但抗性来自模型，不等于工程有防线）。
# MiniMax M2.x thinking 不能关闭，客户端会拆分 reasoning；TokenHub 各模型免费额度彼此独立。
HUNYUAN_MODEL=qwen3.5-flash
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
AGENT_MAX_STEPS=3
AGENT_TOOL_CALL_BUDGET=2
SESSION_HISTORY_MESSAGE_LIMIT=8
SESSION_HISTORY_CHAR_BUDGET=4000
HTTP_FETCH_TIMEOUT_MS=8000
HTTP_FETCH_RETRIES=2
HTTP_FETCH_MAX_CHARS=4000
HTTP_FETCH_MAX_RESPONSE_BYTES=12000
HTTP_FETCH_ALLOWED_CONTENT_TYPES=text/html,text/plain,application/json,application/xhtml+xml
HTTP_FETCH_ALLOW_HOSTS=
HTTP_FETCH_DENY_HOSTS=localhost,127.0.0.1,0.0.0.0
READ_FILE_ROOT_DIR=
READ_FILE_MAX_BYTES=8192
READ_FILE_ALLOWED_EXTENSIONS=.txt,.md,.json,.yaml,.yml
READ_FILE_DENIED_BASENAMES=.env,.env.local,credentials.json
# list_dir 单次返回上限；沙箱根目录同 READ_FILE_ROOT_DIR（未设时默认 evals/fixtures）
LIST_DIR_MAX_ENTRIES=50
# search_docs 检索片段数与切块大小；索引根目录同 READ_FILE_ROOT_DIR
SEARCH_DOCS_MAX_RESULTS=3
SEARCH_DOCS_CHUNK_CHARS=500
# search_docs 检索模式：keyword（默认，无需 rag:index）| vector | hybrid
SEARCH_DOCS_MODE=keyword
# E.7-B 向量检索 embedding 模型；TokenHub 用 kinfra-text-embedding-0.6b，勿用 OpenAI 的 text-embedding-3-small
HUNYUAN_EMBEDDING_MODEL=kinfra-text-embedding-0.6b
# E.8：wait 工具最长秒数（手测取消请用「等待 15 秒」这类长任务）
WAIT_TOOL_MAX_SECONDS=30
# E.8：单次任务超时（毫秒）；不设或 0 = 不启用。取消仍可用 POST /tasks/:id/cancel
AGENT_TASK_TIMEOUT_MS=
# E.9：估算成本单价（USD / 百万 token）；仅学习对照，非真实账单
LLM_PRICE_PROMPT_PER_1M_USD=0.5
LLM_PRICE_COMPLETION_PER_1M_USD=1.5
# E.10：危险工具（write_file）是否跳过人工确认。dev:server 手测须 false/空；evals:run 脚本会强制 true
CONFIRMATION_AUTO_APPROVE=
# E.12：编排模式 supervisor（路由+专家）| single（全量工具直跑 Planner）
# qwen3.5-flash 不支持 Supervisor 的 tool_choice=required（会 400 / specialty routing failed），
# 学习期与注入手测请用 single；换回 minimax-m2.5 后可改 supervisor。
AGENT_ORCHESTRATION=single
PORT=3000
DATABASE_URL=postgres://agent:agent@127.0.0.1:5432/agent_app
# E.13：HTTP 接口鉴权 token；留空=不鉴权（仅限本地学习环境，server.ts 启动会 warn 提醒）
# 设置后所有请求（/health 除外）须带 Authorization: Bearer <此处的值>
API_AUTH_TOKEN=
# E.13：按客户端 IP 的限流窗口（ms）与窗口内最大请求数；/health 不计入
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
